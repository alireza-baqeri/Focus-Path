// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  settings         Settings?
  courses          Course[]
  dayRecords       DayRecord[]
  goals            Goal[]
  activityCategories ActivityCategory[]
}

model Settings {
  id                String   @id @default(cuid())
  userId            String   @unique
  quoteCategory     String?  @default("inspire") // Quote Garden category
  newsCountry       String?  @default("us")      // NewsAPI country
  weatherCity       String?  @default("Tehran")  // Open-Meteo city
  newsLastFetchedAt DateTime?
  cachedNewsData    String?  // Stored as JSON string

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id            String    @id @default(cuid())
  userId        String
  title         String
  rootPath      String
  totalDuration Int       @default(0) // in seconds
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections      Section[]
}

model Section {
  id          String    @id @default(cuid())
  courseId    String
  title       String
  orderIndex  Int
  
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  videos      Video[]
}

model Video {
  id            String    @id @default(cuid())
  sectionId     String
  title         String
  duration      Int       // in seconds
  isWatched     Boolean   @default(false)
  watchedAtDate DateTime? // To attribute to a specific day
  isFlagged     Boolean   @default(false)
  notes         String?

  section       Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model DayRecord {
  id          String    @id @default(cuid())
  userId      String
  date        DateTime  // Store at 00:00:00 for the day
  wakeTime    String?   // "07:30 AM"
  sleepTime   String?   // "11:00 PM"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalEntries  JournalEntry[]
  activityLogs    ActivityLog[]
  goalProgresses  DayGoalProgress[]

  @@unique([userId, date])
}

model JournalEntry {
  id          String    @id @default(cuid())
  dayRecordId String
  content     String
  orderIndex  Int

  dayRecord   DayRecord @relation(fields: [dayRecordId], references: [id], onDelete: Cascade)
}

model ActivityCategory {
  id          String    @id @default(cuid())
  userId      String
  name        String    // "Coding", "Sports", etc.
  emoji       String?
  colorCode   String?   // "#ff0000"

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityLogs ActivityLog[]
}

model ActivityLog {
  id              String    @id @default(cuid())
  dayRecordId     String
  categoryId      String
  durationMinutes Int

  dayRecord       DayRecord        @relation(fields: [dayRecordId], references: [id], onDelete: Cascade)
  category        ActivityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Goal {
  id                String    @id @default(cuid())
  userId            String
  title             String
  targetDescription String?
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressRecords   DayGoalProgress[]
}

model DayGoalProgress {
  id          String    @id @default(cuid())
  dayRecordId String
  goalId      String
  description String

  dayRecord   DayRecord @relation(fields: [dayRecordId], references: [id], onDelete: Cascade)
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
}
